{
  "expo": {
    "name": "BeStats",
    "slug": "bestats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bestats",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.kris1027.bestats",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:bestats-app.vercel.app"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kris1027.bestats",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bestats-app.vercel.app",
              "pathPrefix": "/movies/"
            },
            {
              "scheme": "https",
              "host": "bestats-app.vercel.app",
              "pathPrefix": "/shows/"
            },
            {
              "scheme": "https",
              "host": "bestats-app.vercel.app",
              "pathPrefix": "/games/"
            },
            {
              "scheme": "https",
              "host": "bestats-app.vercel.app",
              "path": "/reset-password/app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "87727533-e590-47f5-bc93-3670ce25d07f"
      }
    },
    "owner": "kris1027dev"
  }
}
