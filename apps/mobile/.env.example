# Public values only: everything here is inlined into the app bundle.
# Never add a TMDB, IGDB or service role secret (security-boundary.test.ts).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# The web app that serves /api/v1.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Mirrors NEXT_PUBLIC_AUTH_EMAIL_DELIVERY; "off" hides Forgot password.
EXPO_PUBLIC_AUTH_EMAIL_DELIVERY=off
