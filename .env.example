# BeStats environment variables.
#
# Copy this file to .env.local and fill in real values. .env.local is ignored by
# git; this file is committed and must never contain a real credential.
#
# Anything named NEXT_PUBLIC_* is inlined into the browser bundle at build time,
# so only values that are safe to publish may carry that prefix.

# ---------------------------------------------------------------------------
# Supabase (public)
# ---------------------------------------------------------------------------

# Your Supabase project URL, with NO path on the end.
# Dashboard: Project Settings > Data API. The dashboard displays a RESTful
# endpoint ending in /rest/v1/ -- do not paste that. The client libraries append
# their own paths, so a trailing /rest/v1/ turns every auth call into a
# confusing PostgREST 404. For the local CLI stack this is http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key. This is the key the browser is meant to use; Row Level
# Security, not secrecy, protects user data. Safe to expose.
# Dashboard: Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# ---------------------------------------------------------------------------
# Server only. Never prefix any of these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# TMDB API Read Access Token (v4 auth), sent as an Authorization: Bearer header
# by the server only TMDB module. Keep it off the browser.
# Get one at https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token

# ---------------------------------------------------------------------------
# Site (public)
# ---------------------------------------------------------------------------

# The absolute origin this app is served from. Supabase builds the links inside
# confirmation and password recovery emails from it, so it must match the
# Supabase redirect allow list exactly (site_url and additional_redirect_urls in
# supabase/config.toml locally, Authentication > URL Configuration on the cloud
# project). No trailing slash. On Vercel this is the deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
