{
  "name": "bestats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @bestats/web dev",
    "dev:docker": "./scripts/dev-docker.sh",
    "build": "pnpm --filter @bestats/web build",
    "start": "pnpm --filter @bestats/web start",
    "lint": "biome check",
    "lint:ci": "biome ci --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "pnpm --filter @bestats/web typecheck",
    "test": "pnpm --filter @bestats/web test",
    "test:watch": "pnpm --filter @bestats/web test:watch",
    "test:coverage": "pnpm --filter @bestats/web test:coverage",
    "test:db": "supabase test db",
    "tmdb:live": "pnpm --filter @bestats/web tmdb:live",
    "igdb:live": "pnpm --filter @bestats/web igdb:live",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/supabase/database.types.ts",
    "db:types:check": "./scripts/db-types-check.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "supabase": "2.117.0"
  },
  "packageManager": "pnpm@11.15.1"
}
